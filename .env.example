# Anthropic — gebruikt door /api/discovery om elke lead direct een AI-pre-analyse te geven
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-sonnet-4-6)
# KAELO_ANALYSE_MODEL=claude-sonnet-4-6

# Notion — bestaande Kaelo CRM workspace
# 1. Maak een interne integratie op https://www.notion.so/profile/integrations
# 2. Deel de "📊 Kaelo CRM" pagina (en daaronder de "🌱 Leads" database) met die integratie
# 3. Plak het Internal Integration Token hieronder
NOTION_API_KEY=

# Database IDs uit jouw Notion workspace
# Leads — waar /api/discovery elke nieuwe lead naartoe schrijft
NOTION_LEADS_DATABASE_ID=a3c6f81a-23b3-4984-bcd0-ed033a2bc0a1
# Projecten — actieve builds (relations naar Leads/Deals/Companies)
NOTION_PROJECTS_DATABASE_ID=57c7067f-ec5c-4658-a37e-d38db000b862

# Resend — voor lead-notificaties naar hallo@kaelo-consulting.com
# 1. Maak een gratis account op https://resend.com (100 mails/dag gratis)
# 2. Settings → API Keys → Create API Key → kopieer hier
# 3. Plak in Vercel env vars
RESEND_API_KEY=
# Optional — overschrijf alleen als je je eigen domein geverifieerd hebt in Resend
KAELO_NOTIFY_FROM=Kaelo <onboarding@resend.dev>
KAELO_NOTIFY_TO=hallo@kaelo-consulting.com
